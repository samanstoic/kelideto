APP_NAME=KeyPro
APP_ENV=local
APP_KEY=
INITIAL_SETUP_TOKEN=
PASSKEY_RP_ID=127.0.0.1
PASSKEY_ALLOWED_ORIGINS=http://127.0.0.1:8001
PASSKEYS_USER_HANDLE_SECRET=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=http://127.0.0.1:8001

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (PostgreSQL 16 + PostGIS 3.4)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=keypro_db
DB_USERNAME=keypro_user
DB_PASSWORD=

# Cache, Session, Queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_EXPIRATION=1440

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=keypro_cache_

NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@keypro.ir"
MAIL_FROM_NAME="${APP_NAME}"

# Adapters & External Services (Iran Localized)
SMS_DRIVER=mock
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=10008663
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:support@kelideto.com

PAYMENT_GATEWAY_DRIVER=disconnected
ZARINPAL_MERCHANT_ID=
PAYMENT_DRIVER=mock
MAP_TILE_PROVIDER=openstreetmap

# Frontend Vite Environment Variables
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_DEFAULT_LAT=35.6892
VITE_DEFAULT_LNG=51.3890
VITE_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
